# ── Supabase ──────────────────────────────────────────────────────────
# The service role key bypasses row level security. It is server-only and must
# never be given a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_SUPABASE_ANON_KEY is no longer used. Nothing in the browser talks
# to Supabase any more — every read goes through a route handler on the server.
# You can delete it from your deployment.

# ── Payments ──────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxx

# ── Admin ─────────────────────────────────────────────────────────────
# Checked on the server. Change it here, not in the code — the old password was
# hardcoded in the source and shipped in the browser bundle.
ADMIN_PASSWORD=
# Signs the admin session cookie. Any long random string:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── Vendor (fallbacks only) ───────────────────────────────────────────
# The values saved in Admin → Vendors always win over these.
VENDOR_API_KEY=
VENDOR_BASE_URL=https://www.xpresportal.app/api/v1

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://chaledata.com
